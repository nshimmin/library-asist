{
  // GitHub's standard Codespaces image. It's pre-loaded on GitHub's machines,
  // so codespaces start in a minute or two instead of downloading an image.
  // It already includes Python and git. Install packages as needed, e.g.:
  //   pip install -r requirements.txt        (everything the app uses; slow)
  //   pip install llama-index-readers-web    (just what webimport.py needs)
  "name": "Library assistant (standard image)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit app" }
  }
}
